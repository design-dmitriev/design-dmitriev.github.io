# --- Зависимости ---
node_modules/

# --- Локальные настройки инструментов ---
.claude/settings.local.json

# --- Мусор ОС и редакторов ---
Thumbs.db
desktop.ini
.DS_Store
*.swp
.vscode/
.idea/

# --- Исходники, не относящиеся к сайту ---
# Рабочие выгрузки и фотоархив: лежат на диске, в репозиторий не попадают.
# Выгрузка_Баннеры удалена — была полным дублем assets/portfolio/Реклама.
/Выгрузка/
/Фотки/

# --- Медиа сайта: пока вне репозитория ---
# Это ~70 МБ несжатых PNG и MP3. Правила ниже нужно СНЯТЬ после сжатия
# в webp — без картинок опубликованный сайт откроется пустым.
# Тяжёлые оригиналы намеренно не коммитим: иначе они навсегда осядут
# в истории и репозиторий будет весить столько же после замены.
# Обложки/ здесь именно как медиа сайта, а не как «лишняя папка»:
# галерея «Соц сети» грузит картинки прямо оттуда, удалять её нельзя.
/assets/
/Обложки/
/background.mp3
